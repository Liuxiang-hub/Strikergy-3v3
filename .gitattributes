* text=auto

# Files executed or consumed on the Ubuntu/aarch64 robot must keep LF endings.
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.cu text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.msg text eol=lf
*.srv text eol=lf
